# Sao chép file này thành .env rồi điền phần 1. Phần 2 và 3 để nguyên là chạy được.
# Dòng bắt đầu bằng # là ghi chú hoặc giá trị mặc định đang tắt; bỏ dấu # để bật.

# =====================================================================
# 1. PHẢI ĐIỀN
# =====================================================================

# LLM trả lời câu hỏi. Mặc định: gemma4:31b trên Ollama Cloud (miễn phí trong hạn mức).
LLM_MODEL=ollama_chat/gemma4:31b
OLLAMA_API_BASE=https://ollama.com
# Tạo key tại https://ollama.com/settings/keys rồi dán vào sau dấu =
OLLAMA_API_KEY=

# Muốn dùng OpenAI thay cho Ollama Cloud: đặt 2 dòng dưới, bỏ trống OLLAMA_API_KEY.
# LLM_MODEL=openai/gpt-4o
# OPENAI_API_KEY=sk-...

# Không muốn dùng key: đăng nhập Ollama trên máy (`ollama signin`) rồi dùng 2 dòng dưới.
# LLM_MODEL=ollama_chat/gemma4:31b-cloud
# OLLAMA_API_BASE=http://localhost:11434

# Embedding chạy trên Ollama của máy bạn, không cần key. Chỉ cần tải model một lần:
#   ollama pull qwen3-embedding:4b

# =====================================================================
# 2. TÙY CHỌN: chỉ điền khi cần
# =====================================================================

# Đăng nhập bằng Clerk (https://dashboard.clerk.com -> API keys).
# Điền cả hai: phải đăng nhập mới chat được, mỗi tài khoản chỉ thấy lịch sử của mình.
# Để trống cả hai: không cần đăng nhập, lịch sử lưu theo từng trình duyệt.
# Chạy web bằng `pnpm dev` thì dán thêm hai dòng này vào apps/web/.env.local.
# NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...
# CLERK_SECRET_KEY=sk_test_...

# Model chấm điểm cho RAGAS (eval/runners/ragas_eval.py); phải khác LLM_MODEL.
# JUDGE_MODEL=ollama_chat/nemotron-3-ultra

# Key của các provider khác, nếu LLM_MODEL dùng provider đó.
# ANTHROPIC_API_KEY=
# GEMINI_API_KEY=

# Giá LLM (USD cho 1 triệu token) để tính cost_usd trong batch/eval; bỏ trống thì không tính.
# LLM_PRICE_IN=0.14
# LLM_PRICE_OUT=0.40

# Model riêng cho bước viết lại câu hỏi; mặc định dùng LLM_MODEL.
# LLM_MODEL_SMALL=

# PostgreSQL và Qdrant server thay cho SQLite và Qdrant nhúng (docker-compose.yml tự đặt sẵn).
# DATABASE_URL=postgresql+psycopg://ircb:ircb@localhost:5432/ircb
# QDRANT_URL=http://localhost:6333
# QDRANT_API_KEY=

# =====================================================================
# 3. KHÔNG CẦN ĐỘNG VÀO: các giá trị mặc định đang dùng
# =====================================================================

# Embedding: phải khớp index/manifest.json. Đổi model thì chạy `uv run ircb index reembed`.
# EMBED_MODEL=ollama/qwen3-embedding:4b
# EMBED_DIMENSIONS=1024
# Ollama phục vụ embedding (luôn là máy local; ollama.com không có model embedding).
# EMBED_API_BASE=http://localhost:11434
# EMBED_CACHE_DIR=./var/embed_cache

# LLM
# LLM_TIMEOUT_S=60
# LLM_SEED=42
# VLM_MODEL=

# Tìm kiếm
# INDEX_DIR=./index
# TOP_K=8
# REFUSAL_THRESHOLD=0.35

# Lưu trữ local
# DATABASE_URL=sqlite:///./var/app.db
# QDRANT_PATH=./var/qdrant
# QDRANT_COLLECTION_PREFIX=ircb_
# AUTO_LOAD_INDEX=true

# Khác
# TRACE_DIR=./traces
# PAGE_CACHE_DIR=./var/page_cache
# PDF_PATH=./data/techcombank-bao-cao-thuong-nien-2025-vie-update.pdf
# APP_ENV=dev
# API_HOST=127.0.0.1
# API_PORT=8000
# CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
