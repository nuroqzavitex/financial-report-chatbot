# --- LLM ---
LLM_MODEL=openai/gpt-4o            # required, LiteLLM syntax
# LLM_MODEL_SMALL=                 # rewriter; defaults to LLM_MODEL
# JUDGE_MODEL=                     # RAGAS judge; should differ from LLM_MODEL
# VLM_MODEL=                       # optional image description at ingest
# LLM_SEED=42                      # used when model lacks temperature=0
# LLM_PRICE_IN=                    # USD / 1M tokens
# LLM_PRICE_OUT=
OPENAI_API_KEY=                    # for the default LLM; embeddings run on Ollama
# ANTHROPIC_API_KEY=
# GEMINI_API_KEY=
# OLLAMA_API_BASE=http://localhost:11434
# OLLAMA_API_KEY=                  # only when OLLAMA_API_BASE=https://ollama.com
# LLM_TIMEOUT_S=60
# e.g. LLM_MODEL=ollama_chat/gpt-oss:120b-cloud through a signed-in local Ollama (no key needed)

# --- Embedding ---
# EMBED_MODEL=ollama/qwen3-embedding:0.6b   # must match index/manifest.json; `ollama pull qwen3-embedding:0.6b`
# e.g. EMBED_MODEL=openai/text-embedding-3-large or gemini/gemini-embedding-001 (with its key);
#      after any change run `ircb index reembed`
# EMBED_DIMENSIONS=1024
# EMBED_CACHE_DIR=./var/embed_cache

# --- Retrieval ---
# INDEX_DIR=./index
# TOP_K=8
# REFUSAL_THRESHOLD=0.35          # provisional; calibrated by eval (Task 22)

# --- Storage ---
# DATABASE_URL=sqlite:///./var/app.db
# QDRANT_URL=                      # set => Qdrant server, else embedded
# QDRANT_PATH=./var/qdrant
# QDRANT_API_KEY=
# QDRANT_COLLECTION_PREFIX=ircb_
# AUTO_LOAD_INDEX=true

# --- Misc ---
# TRACE_DIR=./traces
# PAGE_CACHE_DIR=./var/page_cache
# PDF_PATH=./data/techcombank-bao-cao-thuong-nien-2025-vie-update.pdf
# APP_ENV=dev
# API_HOST=127.0.0.1
# API_PORT=8000
# CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# --- Sign-in (optional, Clerk: https://dashboard.clerk.com -> API keys) ---
# Both set: chat and history need a Clerk account and each account sees only its own history.
# Both empty: no sign-in, history is kept per browser. The API reads the same publishable key.
# For `pnpm dev`, also put both in apps/web/.env.local.
# NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...
# CLERK_SECRET_KEY=sk_test_...
